# Deployed HTTP API base URL (no trailing slash)
VITE_API_URL=https://xxxxxxxx.execute-api.us-east-1.amazonaws.com
# Cognito user pool app client (USER_PASSWORD_AUTH + REFRESH_TOKEN_AUTH enabled)
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_CLIENT_ID=
# 1 = run entirely on seeded demo data (no API, no login)
VITE_DEMO=0
# Optional: static JWT used as the bearer token, skipping the login screen (dev only)
VITE_DEV_TOKEN=
